SELECT u.id AS "userId", u.full_name AS "userName", u.email, u.is_active AS "userActive", u.last_login_at AS "lastLoginAt", u.failed_login_attempts AS "failedLoginAttempts", u.lockout_until AS "lockoutUntil", u.lockout_until IS NOT NULL AND u.lockout_until > @__now_0 AS "isLocked", v0.id AS "vendorId", v0.vendor_code AS "vendorCode", v0.vendor_name AS "vendorName", v0.oracle_vendor_id AS "oracleVendorId", v.is_active AND u.is_active AS "accessActive", v.is_primary AS "isPrimary", u.password_hash IS NOT NULL AND btrim(u.password_hash, E' \t\n\r') <> '' AS "passwordSetupCompleted"
FROM master.vendor_users AS v
