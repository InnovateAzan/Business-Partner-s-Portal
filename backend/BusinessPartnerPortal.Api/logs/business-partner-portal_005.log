SELECT t."Id", t."VendorCode", t."VendorName", t."OracleVendorId"
FROM (
    SELECT DISTINCT v.id AS "Id", v.vendor_code AS "VendorCode", v.vendor_name AS "VendorName", v.oracle_vendor_id AS "OracleVendorId"
    FROM master.vendors AS v
    INNER JOIN master.vendor_users AS v0 ON v.id = v0.vendor_id
    INNER JOIN security.users AS u ON v0.user_id = u.id
    WHERE v.is_active AND v0.is_active AND u.is_active AND v.oracle_vendor_id IS NOT NULL AND v.oracle_vendor_id <> ''
) AS t
ORDER BY t."VendorName"
